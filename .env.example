# Database (docker compose overrides this for the app container)
DATABASE_URL=postgresql://onboarding:onboarding@127.0.0.1:5432/onboarding
# Direct connection for migrations (on Neon: the unpooled URL; locally the same as DATABASE_URL)
DATABASE_URL_UNPOOLED=postgresql://onboarding:onboarding@127.0.0.1:5432/onboarding

# Signs login sessions. Use a random string of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace_with_a_long_random_string

# Decides what "today" is for start dates, the current week and overdue steps and goals
APP_TIMEZONE=Europe/Amsterdam

# Set to true when the portal is served over HTTPS
COOKIE_SECURE=false

# First admin account, created on first start if no admin exists.
# The admin must change this password at first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=Administrator

# Comma-separated host names when running behind a reverse proxy, e.g. onboarding.internal.example
ALLOWED_ORIGINS=

# Docker compose: published app port, database password and local database port
APP_PORT=3000
POSTGRES_PASSWORD=onboarding
DB_PORT=5432
